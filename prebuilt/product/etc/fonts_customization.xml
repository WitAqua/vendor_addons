<?xml version="1.0" encoding="utf-8"?>
<fonts-modification version="1">

    <!-- Koruri -->
    <family customizationType="new-named-family" name="Koruri">
        <font weight="300" style="normal" postScriptName="Koruri-Light">
            Koruri-Light.ttf
        </font>
        <font weight="400" style="normal" postScriptName="Koruri-Regular">
            Koruri-Regular.ttf
        </font>
        <font weight="600" style="normal" postScriptName="Koruri-SemiBold">
            Koruri-SemiBold.ttf
        </font>
        <font weight="700" style="normal" postScriptName="Koruri-Bold">
            Koruri-Bold.ttf
        </font>
        <font weight="800" style="normal" postScriptName="Koruri-ExtraBold">
            Koruri-ExtraBold.ttf
        </font>
    </family>

    <!-- Lato -->
    <family customizationType="new-named-family" name="lato">
        <font weight="400" style="normal">Lato-Regular.ttf</font>
        <font weight="400" style="italic">Lato-Italic.ttf</font>
        <font weight="500" style="normal">Lato-Medium.ttf</font>
        <font weight="500" style="italic">Lato-MediumItalic.ttf</font>
        <font weight="700" style="normal">Lato-Bold.ttf</font>
        <font weight="700" style="italic">Lato-BoldItalic.ttf</font>
    </family>
    <alias name="lato-light" to="lato" weight="300" />
    <alias name="lato-regular" to="lato" weight="400" />
    <alias name="lato-medium" to="lato" weight="500" />
    <alias name="lato-semi-bold" to="lato" weight="600" />
    <alias name="lato-bold" to="lato" weight="700" />

    <!-- Mejiro -->
    <family customizationType="new-named-family" name="Mejiro">
        <font weight="100" style="normal" postScriptName="Mejiro-Thin">
            Mejiro-Thin.ttf
        </font>
        <font weight="300" style="normal" postScriptName="Mejiro-Light">
            Mejiro-Light.ttf
        </font>
        <font weight="400" style="normal" postScriptName="Mejiro-Regular">
            Mejiro-Regular.ttf
        </font>
        <font weight="600" style="normal" postScriptName="Mejiro-SemiBold">
            Mejiro-SemiBold.ttf
        </font>
        <font weight="700" style="normal" postScriptName="Mejiro-Bold">
            Mejiro-Bold.ttf
        </font>
        <font weight="800" style="normal" postScriptName="Mejiro-ExtraBold">
            Mejiro-ExtraBold.ttf
        </font>
    </family>

    <!-- Mikachan -->
    <family customizationType="new-named-family" name="Mikachan">
        <font weight="400" style="normal">Mikachan.ttf</font>
    </family>

    <!-- Rubik -->
    <family customizationType="new-named-family" name="rubik">
        <font weight="400" style="normal">Rubik-Regular.ttf</font>
        <font weight="400" style="italic">Rubik-Italic.ttf</font>
        <font weight="500" style="normal">Rubik-Medium.ttf</font>
        <font weight="500" style="italic">Rubik-MediumItalic.ttf</font>
        <font weight="700" style="normal">Rubik-Bold.ttf</font>
        <font weight="700" style="italic">Rubik-BoldItalic.ttf</font>
    </family>
    <alias name="rubik-light" to="rubik" weight="300" />
    <alias name="rubik-regular" to="rubik" weight="400" />
    <alias name="rubik-medium" to="rubik" weight="500" />
    <alias name="rubik-semi-bold" to="rubik" weight="600" />
    <alias name="rubik-bold" to="rubik" weight="700" />
</fonts-modification>